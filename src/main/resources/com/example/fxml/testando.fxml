<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      prefWidth="380"
      spacing="12"
      styleClass="character-card">

    <!-- HEADER -->

    <HBox alignment="CENTER_LEFT">

        <VBox HBox.hgrow="ALWAYS">

            <HBox spacing="8">
                <Label text="Thorgal"
                       styleClass="character-name"/>

                <Label text="Lvl 3"
                       styleClass="level-badge"/>
            </HBox>

            <Label text="Meio-Orc • Bárbaro"
                   styleClass="subtitle"/>

        </VBox>

        <Button text="🗑"
                styleClass="delete-button"/>

    </HBox>

    <Separator/>

    <!-- HP -->

    <VBox spacing="5">

        <HBox>
            <Label text="❤️ HP"
                   HBox.hgrow="ALWAYS"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="35 / 45"/>
        </HBox>

        <ProgressBar progress="0.78"
                     styleClass="hp-bar"
                     maxWidth="Infinity"/>

    </VBox>

    <!-- XP -->

    <VBox spacing="5">

        <HBox>
            <Label text="⭐ XP"
                   HBox.hgrow="ALWAYS"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="1200 / 2700"/>
        </HBox>

        <ProgressBar progress="0.44"
                     styleClass="xp-bar"
                     maxWidth="Infinity"/>

    </VBox>

    <Separator/>

    <!-- STATS -->

    <HBox alignment="CENTER">

        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <Label text="ATK" styleClass="stat-title"/>
            <Label text="15" styleClass="stat-value"/>
        </VBox>

        <Separator orientation="VERTICAL"/>

        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <Label text="DEF" styleClass="stat-title"/>
            <Label text="12" styleClass="stat-value"/>
        </VBox>

        <Separator orientation="VERTICAL"/>

        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <Label text="OURO" styleClass="stat-title"/>
            <Label text="450" styleClass="stat-value"/>
        </VBox>

    </HBox>

    <Separator/>

    <!-- INVENTÁRIO -->

    <VBox spacing="8">

        <HBox>

            <Label text="INVENTÁRIO"
                   styleClass="section-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Hyperlink text="+ Add"/>

        </HBox>

        <VBox spacing="6">

            <VBox styleClass="inventory-item">

                <Label text="Machado Grande"/>

                <Label text="Dano cortante 1d12"
                       styleClass="item-description"/>

            </VBox>

        </VBox>

    </VBox>

    <!-- TAGS -->

    <FlowPane hgap="8"
              vgap="8">

        <Label text="Comum"
               styleClass="tag"/>

        <Label text="Orc"
               styleClass="tag"/>

    </FlowPane>

    <Region VBox.vgrow="ALWAYS"/>

    <!-- ACTIONS -->

    <HBox spacing="8">

        <Button text="Dano"
                styleClass="action-button"/>

        <Button text="Cura"
                styleClass="action-button"/>

        <Button text="+ XP"
                styleClass="action-button"/>

        <Button text="+ Ouro"
                styleClass="action-button"/>

        <Button text="- Ouro"
                styleClass="action-button"/>

    </HBox>

</VBox>